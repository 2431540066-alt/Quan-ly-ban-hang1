generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  name     String
  role     String // OWNER | SALES | WAREHOUSE | CUSTOMER
  orders   Order[]
  customer Customer?
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id           Int             @id @default(autoincrement())
  barcode      String?         @unique
  name         String
  description  String?
  price        Int
  cost         Float           @default(0)
  stock        Int             @default(0)
  minStock     Int             @default(5)
  categoryId   Int?
  category     Category?       @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  receiptItems ReceiptItem[]
  movements    StockMovement[]
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String?
  userId Int?    @unique
  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]
}

model Promotion {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String // PERCENT | AMOUNT
  value     Int
  expiresAt DateTime?
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  customerId      Int?
  total           Int
  discount        Int         @default(0)
  payment         String
  status          String      @default("PAID") // PENDING | CONFIRMED | SHIPPING | PAID | CANCELLED
  shippingAddress String?
  createdAt       DateTime    @default(now())
  user            User        @relation(fields: [userId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int
  price     Int
  cost      Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String?
  address  String?
  receipts Receipt[]
}

model Receipt {
  id         Int           @id @default(autoincrement())
  supplierId Int?
  status     String        @default("DRAFT") // DRAFT | CONFIRMED
  note       String?
  total      Int
  createdAt  DateTime      @default(now())
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  items      ReceiptItem[]
}

model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  qty       Int
  cost      Int
  receipt   Receipt @relation(fields: [receiptId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  type      String // IN | OUT | ADJUST
  qty       Int
  ref       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
