generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                     @id @default(autoincrement())
  username        String                  @unique
  password        String
  name            String
  email           String?                 @unique
  emailVerifiedAt DateTime?
  role            String // OWNER | SALES | WAREHOUSE | CUSTOMER
  orders          Order[]
  customer        Customer?
  addresses       UserAddress[]
  favorites       Favorite[]
  reviews         ProductReview[]
  resetTokens     PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  returnRequests  ReturnRequest[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id           Int             @id @default(autoincrement())
  barcode      String?         @unique
  name         String
  description  String?
  imageUrl     String?
  price        Int
  cost         Float           @default(0)
  stock        Int             @default(0)
  minStock     Int             @default(5)
  categoryId   Int?
  category     Category?       @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  receiptItems ReceiptItem[]
  movements    StockMovement[]
  favorites    Favorite[]
  reviews      ProductReview[]
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String?
  userId Int?    @unique
  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]
}

model Promotion {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String // PERCENT | AMOUNT
  value     Int
  expiresAt DateTime?
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  customerId      Int?
  total           Int
  discount        Int         @default(0)
  shippingFee     Int         @default(0)
  payment         String
  paymentStatus   String      @default("PAID") // PENDING | PAID | FAILED
  status          String      @default("PAID") // PENDING | CONFIRMED | SHIPPING | PAID | CANCELLED
  shippingAddress String?
  shippingTrackingCode String?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  user            User        @relation(fields: [userId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  returnRequest   ReturnRequest?
}

model PaymentAttempt {
  id             Int      @id @default(autoincrement())
  orderId        Int
  provider       String
  transactionRef String   @unique
  providerTxnId  String?
  amount         Int
  status         String   @default("PENDING") // PENDING | PAID | FAILED
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id])
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model ReturnRequest {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  userId    Int
  reason    String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  staffNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int
  price     Int
  cost      Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String?
  address  String?
  receipts Receipt[]
}

model Receipt {
  id         Int           @id @default(autoincrement())
  supplierId Int?
  status     String        @default("DRAFT") // DRAFT | CONFIRMED
  note       String?
  total      Int
  createdAt  DateTime      @default(now())
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  items      ReceiptItem[]
}

model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  qty       Int
  cost      Int
  receipt   Receipt @relation(fields: [receiptId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  type      String // IN | OUT | ADJUST
  qty       Int
  ref       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
